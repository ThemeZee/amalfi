					"color": "#0b1020",
					"name": "Primary 50",
					"slug": "primary-50"
				},
				{
					"color": "#121a33",
					"name": "Primary 100",
					"slug": "primary-100"
				},
				{
					"color": "#1b2545",
					"name": "Primary 200",
					"slug": "primary-200"
				},
				{
					"color": "#273257",
					"name": "Primary 300",
					"slug": "primary-300"
				},
				{
					"color": "#394674",
					"name": "Primary 400",
					"slug": "primary-400"
				},
				{
					"color": "#51608f",
					"name": "Primary 500",
					"slug": "primary-500"
				},
				{
					"color": "#8192c2",
					"name": "Primary 600",
					"slug": "primary-600"
				},
				{
					"color": "#a3b2de",
					"name": "Primary 700",
					"slug": "primary-700"
				},
				{
					"color": "#c6d1ef",
					"name": "Primary 800",
					"slug": "primary-800"
				},
				{
					"color": "#dee6f8",
					"name": "Primary 900",
					"slug": "primary-900"
				},
				{
					"color": "#eef3fc",
					"name": "Primary 950",
					"slug": "primary-950"
				},
				{
					"color": "#0b1020",
					"name": "On Accent",
					"slug": "white"
				},
				{
					"color": "#000000",
					"name": "Black",
					"slug": "black"
				}
			]
		},
		"custom": {
			"fontFamily": {
				"body": "var:preset|font-family|manrope",
				"display": "var:preset|font-family|space-grotesk"
			},
			"lineHeight": {
				"body": "1.6",
				"display": "1.15"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|primary-50",
			"text": "var:preset|color|primary-950"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontStyle": "normal",
					"letterSpacing": "-0.01em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontStyle": "normal"
				}
			}
		}
	}
}
